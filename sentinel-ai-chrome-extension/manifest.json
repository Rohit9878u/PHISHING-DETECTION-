{
  "manifest_version": 3,
  "name": "Sentinel AI Phishing Detector",
  "version": "1.0.0",
  "description": "Scan the current page URL with your existing Sentinel AI phishing detector.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:5002/*"
  ],
  "action": {
    "default_title": "Scan with Sentinel AI",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
